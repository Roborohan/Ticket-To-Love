<!DOCTYPE html>
<html lang="en">
    
    <!-- THE HEAD TAG PARTIAL -->
    <%- include("../authpartials/head") %>

    <body>
        <!-- THE HEADER TAG PARTIAL -->
        <%- include("../authpartials/header") %>
        <main>
            <h1 class="welcomeText">LOGIN</h1>
            <div class="form-design">
                <form action = "/auth/login" method="POST" style="background-color:cornflowerblue;padding:10vh">
                    <input type="text" name="username" placeholder="username" style="font-size:1em;" required><br><br>
                    <input type="password" name="password" placeholder="* * * * * * * *" style="font-size:1em;" required><br><br>
                    <input type="submit" value="LOGIN" style="font-size:1em;height:100%;width:100%;"><br>
                </form>
            </div>
        </main>
        <!-- THE FOOTER TAG PARTIAL -->
        <%- include("../authpartials/footer") %>
    </body>
</html>