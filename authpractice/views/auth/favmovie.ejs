<!DOCTYPE html>
<html lang="en">
    <!-- THE HEAD TAG PARTIAL -->
    <%- include("../partials/head") %>
    <body>
        <!-- THE HEADER TAG PARTIAL -->
        <%- include("../partials/header") %>
        <main>
            <h1 class="welcomeText">Pick Your Favourite Movies</h1>
            <h2 class="subtext">you can pick up to 10</h2>
            <form id="movie-form" autocomplete="on">
                <input type="text" id="movie" placeholder="Movie...">
                <button id="movie-btn">Search Movie</button>
            </form>
            <div id="result"></div>
            <div class="fav-posters">
                <h1 class="welcomeText">My Favourite Movies</h1><br>
                <% let count = 0; %>
                <% favMovies.forEach(favMovie => { %>
                  <div class="fav-poster" style="display: inline-block; position: relative;">
                    <img src="<%= favMovie.poster %>" width="200" />
                    <div class="delete-fav-container" style="position: absolute; top: 0; right: 0;">
                      <a href="#" class="delete-fav" data-id="<%= favMovie._id %>">x</a>
                    </div>
                  </div>
                  <% count++; %>
                  <% if (count % 5 === 0) { %>
                    <br>
                  <% } %>
                <% }); %>
            </div>
              
                         
        </main>
        <!-- THE FOOTER TAG PARTIAL -->
        <%- include("../partials/footer") %>
    </body>
    <script>
        $(document).ready(function(){
            var apikey = "REDACTED_API_KEY"
            $("#movie-form").submit(function(event){
                event.preventDefault()
                var movie = $("#movie").val()
                var result = ""
                var url = "http://www.omdbapi.com/?apikey="+apikey
                $.ajax({
                    method: 'GET',
                    url: url+"&t="+movie,
                    success: function(data){
                        console.log(data)
                        if(data.Response == "False"){
                            $("#result").html(`<h2>Movie not found! Try again.</h2>`);
                        }
                        else {
                            result = `
                            <div style="display: flex; flex-direction: column; align-items: center;">
                                <div style="display: flex;">
                                    <img width="200" height="200" src="${data.Poster}" />
                                    <div style="margin-left: 10px;">
                                        <h2>Title: ${data.Title}</h2>
                                        <h2>Date of Release: ${data.Released}</h2>
                                        <h2>Runtime: ${data.Runtime}</h2>
                                        <h2>Genre: ${data.Genre}</h2>
                                        <h2>Actors: ${data.Actors}</h2>
                                        <h2>Director: ${data.Director}</h2>
                                        <h2>Country: ${data.Country}</h2>
                                        <h2>Rating: ${data.imdbRating}</h2>
                                        <form action="/auth/favmovie" method="POST">
                                            <input type="hidden" name="title" value="${data.Title}" />
                                            <input type="hidden" name="releaseDate" value="${data.Released}" />
                                            <input type="hidden" name="runtime" value="${data.Runtime}" />
                                            <input type="hidden" name="genre" value="${data.Genre}" />
                                            <input type="hidden" name="actors" value="${data.Actors}" />
                                            <input type="hidden" name="director" value="${data.Director}" />
                                            <input type="hidden" name="country" value="${data.Country}" />
                                            <input type="hidden" name="rating" value="${data.imdbRating}" /> <br><br>
                                            <input type="hidden" name="poster" value="${data.Poster}" />
                                            <button type="submit" id="favmovie-btn" >Add To Favourites</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            `
                            $("#result").html(result)

                            $("#add-to-favorites-button").click(function() {
                                $.ajax({
                                    url: "/favmovie",
                                    type: "POST",
                                    data: {
                                        username: req.session.user,
                                        title: data.Title,
                                        releaseDate: data.Released,
                                        runtime: data.Runtime,
                                        genre: data.Genre,
                                        actors: data.Actors,
                                        director: data.Director,
                                        country: data.Country,
                                        rating: data.imdbRating,
                                        poster: data.Poster
                                    },
                                    success: function() {
                                        console.log("Movie added to favorites!");
                                    },
                                    error: function(error) {
                                        console.error(error);
                                    }
                                });
                            });
                        }
                    }
                })
            })
        })
    </script>
    <script>
        $(document).ready(function() {
           $('.delete-fav').click(function(e) {
              e.preventDefault();
              const favId = $(this).data('id');
              $.ajax({
                 url: '/delete-fav',
                 type: 'DELETE',
                 data: { favId: favId },
                 success: function(result) {
                    location.reload();
                 }
              });
           });
        });
     </script>
</html> 