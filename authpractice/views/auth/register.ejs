<!DOCTYPE html>
<html lang="en">
    
    <!-- THE HEAD TAG PARTIAL -->
    <%- include("../authpartials/head") %>

    <body>
        <!-- THE HEADER TAG PARTIAL -->
        <%- include("../authpartials/header") %>
        <main>
            <h1 class="welcomeText">REGISTER</h1>
            <div class="form-design">
                <form action = "/auth/register" method="POST" style="background-color:cornflowerblue;padding:10vh">
                    <input type="name" name="name" placeholder="name" style="font-size:1em;" required><br><br>
                    <input type="text" name="username" placeholder="username" style="font-size:1em;" required><br><br>
                    <input type="password" name="password" id="password" placeholder="password" onChange="onChange()" pattern=".{3,}" title="Password must be at least 3 or more characters"  style="font-size:1em;" required><br><br>
                    <input type="password" name="confirm-password" id="confirm-password" placeholder="confirm password" onChange="onChange()" pattern=".{3,}" title="Password must be at least 3 or more characters" style="font-size:1em;" required><br><br>
                    <input type="text" name="dateofbirth" id="calendar" placeholder="dd/mm/yyyy" style="font-size:1em"> <br><br>
                    <input type="submit" value="REGISTER" style="font-size:1em;height:100%;width:100%;">
                </form>
            </div>  
        </main>
        <!-- THE FOOTER TAG PARTIAL -->
        <%- include("../authpartials/footer") %>
        <script>
            $(document).ready(function(){
                $("#calendar").datepicker({
                    changeMonth: true,
                    changeYear: true,
                    yearRange: "1930:2022",
                    maxDate: "-18y",
                    showAnim: "fadeIn"
                });
            });
        </script>
        <script>
            function onChange() {
                const password = document.querySelector('input[name=password]');
                const confirm = document.querySelector('input[name=confirm-password]');
                if (confirm.value === password.value) {
                    confirm.setCustomValidity('');
                } else {
                    confirm.setCustomValidity('Passwords do not match');
                }
            }
        </script>
    </body>
</html>